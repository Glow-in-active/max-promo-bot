# App
# MODE: demo | simulator | production
MODE=demo
HTTP_PORT=8080
ADMIN_TOKEN=local-administrator-token
DEMO_TOKEN=local-demo-token
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=promo
POSTGRES_USER=promo
POSTGRES_PASSWORD=localdemo-db-password
POSTGRES_SSLMODE=disable
# DATABASE_URL overrides POSTGRES_* when set.
# DATABASE_URL=

# MAX
MAX_TOKEN=
MAX_WEBHOOK_SECRET=local-webhook-secret
CAMPAIGN_ID=
MAX_BANNER_URL=
MAX_CA_FILE=
MAX_API_URL=https://platform-api2.max.ru

# Tests
TEST_DATABASE_PORT=5433
# TEST_DATABASE_URL=postgres://promo_test:localtest-db-password@127.0.0.1:5433/promo_test?sslmode=disable
